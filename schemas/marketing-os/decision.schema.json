{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/scayver/marketing-skills/schemas/marketing-os/decision.schema.json",
  "title": "Marketing OS Decision",
  "type": "object",
  "required": ["schema_version", "decision_id", "run_id", "question", "selected_option", "reason", "evidence", "confidence", "decided_at"],
  "properties": {
    "schema_version": { "type": "string" },
    "decision_id": { "type": "string" },
    "run_id": { "type": "string" },
    "question": { "type": "string" },
    "available_options": { "type": "array" },
    "selected_option": {},
    "reason": { "type": "string" },
    "evidence": { "type": "array" },
    "confidence": { "enum": ["verified", "high", "medium", "low", "estimated", "unavailable"] },
    "decision_maker": { "type": "string" },
    "decided_at": { "type": "string", "format": "date-time" },
    "reversible": { "type": "boolean" },
    "related_artifacts": { "type": "array" },
    "related_metrics": { "type": "array" }
  },
  "additionalProperties": true
}
